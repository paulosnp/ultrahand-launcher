<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UltrahandLauncher</AssemblyName>
    <RootNamespace>Ultrahand</RootNamespace>
    <Version>0.1.1</Version>
    <Product>Ultrahand Launcher</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Images\ultrahand.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- lets CI build it outside Windows; the app itself runs only on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- dotnet publish -c Release: self-contained, no .NET install needed -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- a single UltrahandLauncher.exe: opened from elsewhere, it copies itself to %LOCALAPPDATA%\Programs\Ultrahand Launcher (App.xaml.cs) -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Images\ultrahand.png" />
    <None Include="Fonts\Inter-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
